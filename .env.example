# ---------- Database ----------
# Local dev (Docker container created by the build):
DATABASE_URL=postgres://distributor:distributor@localhost:5433/distributor
# Production: use Neon / Supabase / RDS, e.g.
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require

# ---------- Polar.sh (payments) ----------
# IMPORTANT: Sandbox and production use DIFFERENT tokens, products, and webhooks.
#
# SANDBOX (testing, no real charges):
#   1. Go to https://sandbox.polar.sh/dashboard/settings
#   2. Create a sandbox access token → put in POLAR_ACCESS_TOKEN
#   3. Create a sandbox product → put its ID in POLAR_PRODUCT_ID
#   4. Create a sandbox webhook endpoint → put its secret in POLAR_WEBHOOK_SECRET
#   5. Keep POLAR_ENV=sandbox
#
# PRODUCTION (real charges, set these in Vercel env vars, NOT .env.local):
#   1. Go to https://polar.sh/dashboard/settings
#   2. Create a production access token → set as POLAR_ACCESS_TOKEN in Vercel
#   3. Create a production product → set its ID as POLAR_PRODUCT_ID in Vercel
#   4. Create a production webhook pointing to https://distributor.lol/api/webhook
#      → set its secret as POLAR_WEBHOOK_SECRET in Vercel
#   5. Set POLAR_ENV=production in Vercel
#
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# "sandbox" for testing, "production" for live
POLAR_ENV=sandbox

# ---------- Upstash Redis (optional in dev, required for prod rate limiting) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Admin ----------
ADMIN_PASSWORD=admin-change-me

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Click integrity salt (set to a random string in prod) ----------
CLICK_SALT=distributor-lol-change-me
